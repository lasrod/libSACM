{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "for py in python3 python; do \"$py\" -c '' >/dev/null 2>&1 && exec \"$py\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_write_guard.py\"; done; echo \"agent write guard: no working Python interpreter\" >&2; exit 2",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo xtask:*)",
      "Bash(cargo deny:*)",
      "Bash(python -m unittest:*)"
    ]
  }
}

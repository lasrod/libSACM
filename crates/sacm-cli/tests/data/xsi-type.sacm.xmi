<?xml version="1.0" encoding="UTF-8"?>
<!-- LIB-CLI-002, LIB-CLI-003: the Claim c1 is typed with xsi:type (line 5, column 20), which a tolerant read reports as a SACM-XMI-010 Warning and a strict read as an Error. Otherwise clean. Hand-written. -->
<sacm:ArgumentPackage xmlns:sacm="http://www.omg.org/spec/SACM/20220301" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmi:id="arguments">
  <name lang="en" content="Arguments"/>
  <argumentElement xsi:type="sacm:Claim" xmi:id="c1">
    <name lang="en" content="The system is safe"/>
  </argumentElement>
</sacm:ArgumentPackage>

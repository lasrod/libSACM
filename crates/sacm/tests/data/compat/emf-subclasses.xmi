<?xml version="1.0" encoding="UTF-8"?>
<!-- LIB-COMPAT-017: the dialect EMF writes, with elements typed by xsi:type with classes of an application's profile, urn:example:profile: Bundle (declared an ArgumentPackage), Proposition (a Claim) and Step (an AssertedInference), the role spelling argumentationElement, no xmi:id, and references by EMF fragment path. Hand-written; no third-party content. -->
<assurancecase:AssuranceCasePackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:assurancecase="http://omg.sacm/2.2/assurancecase" xmlns:p="urn:example:profile">
  <name lang="en" content="Brake case"/>
  <argumentPackage xsi:type="p:Bundle">
    <name lang="en" content="Brake arguments"/>
    <argumentationElement xsi:type="p:Proposition">
      <name lang="en" content="The brakes are safe"/>
    </argumentationElement>
    <argumentationElement xsi:type="p:Proposition">
      <name lang="en" content="The brakes were tested"/>
    </argumentationElement>
    <argumentationElement xsi:type="p:Step" source="//@argumentPackage.0/@argumentationElement.1" target="//@argumentPackage.0/@argumentationElement.0">
      <name lang="en" content="Testing supports safety"/>
    </argumentationElement>
  </argumentPackage>
</assurancecase:AssuranceCasePackage>

  <name lang="en" content="Findings"/>
  <argumentPackage xmi:id="p" interface="i">
    <name lang="en" content="P"/>
    <argumentElement xmi:type="sacm:Claim" xmi:id="c"><name lang="en" content="C"/></argumentElement>
    <argumentElement xmi:type="sacm:ArgumentPackageInterface" xmi:id="i" implements="p">
      <name lang="en" content="I"/>
      <argumentElement xmi:type="sacm:Claim" xmi:id="i_cited" isCitation="true" citedElement="c"><name lang="en" content="C"/></argumentElement>
      <argumentElement xmi:type="sacm:Claim" xmi:id="i_plain"><name lang="en" content="Plain"/></argumentElement>
      <argumentElement xmi:type="sacm:Claim" xmi:id="i_far" isCitation="true" citedElement="d"><name lang="en" content="D"/></argumentElement>
    </argumentElement>
  </argumentPackage>
  <argumentPackage xmi:id="q">
    <name lang="en" content="Q"/>
    <argumentElement xmi:type="sacm:Claim" xmi:id="d"><name lang="en" content="D"/></argumentElement>
  </argumentPackage>

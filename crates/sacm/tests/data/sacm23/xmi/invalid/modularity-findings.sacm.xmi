  </argumentPackage>
  <argumentPackage xmi:type="sacm:ArgumentPackageBinding" xmi:id="b2" participantPackage="i b"><name lang="en" content="B2"/></argumentPackage>
  <assuranceCasePackage xmi:type="sacm:AssuranceCasePackageInterface" xmi:id="ai" implements="case">
    <name lang="en" content="AI"/>
    <argumentPackage xmi:id="ap"><name lang="en" content="AP"/></argumentPackage>
  </assuranceCasePackage>
</sacm:AssuranceCasePackage>

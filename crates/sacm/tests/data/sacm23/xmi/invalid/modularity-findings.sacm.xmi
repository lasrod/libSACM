  <argumentPackage xmi:type="sacm:ArgumentPackageInterface" xmi:id="k"><name lang="en" content="K"/></argumentPackage>
  <argumentPackage xmi:type="sacm:ArgumentPackageBinding" xmi:id="b" participantPackage="i i">
    <name lang="en" content="B"/>

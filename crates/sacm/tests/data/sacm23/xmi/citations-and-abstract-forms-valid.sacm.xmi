<?xml version="1.0" encoding="UTF-8"?>
<!-- SACM23-BASE-007, SACM23-BASE-008: `isCitation`, `citedElement`, `isAbstract` and `abstractForm` on packages, Claims and a Note, as attributes and as elements. An abstract ArgumentPackage holds an abstract Claim; c1 conforms to it; c2 cites c1; n1 is a citation with no cited element. Validates without a finding. Hand-written; no third-party content. -->
<sacm:AssuranceCasePackage xmlns:sacm="http://www.omg.org/spec/SACM/20220301" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:id="case">
  <name lang="en" content="Case"/>
  <argumentPackage xmi:id="pattern" isAbstract="true">
    <name lang="en" content="Pattern"/>
    <argumentElement xmi:type="sacm:Claim" xmi:id="abstract_claim">
      <isAbstract>1</isAbstract>
      <name lang="en" content="{System} is safe"/>
    </argumentElement>
  </argumentPackage>
  <argumentPackage xmi:id="arguments">
    <name lang="en" content="Arguments"/>
    <argumentElement xmi:type="sacm:Claim" xmi:id="c1" abstractForm="abstract_claim">
      <name lang="en" content="The brakes are safe"/>
    </argumentElement>
    <argumentElement xmi:type="sacm:Claim" xmi:id="c2" isCitation="true">
      <name lang="en" content="The brakes are safe, as cited"/>
      <citedElement xmi:idref="c1"/>
      <note xmi:id="n1" isCitation="true">
        <content>
          <value lang="en" content="Cited from the supplier's case"/>
        </content>
      </note>
    </argumentElement>
  </argumentPackage>
</sacm:AssuranceCasePackage>
